# ==============================================================================
# CityFlow - Git Ignore Configuration
# ==============================================================================

# Python environments & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
env/
venv/
ENV/
.pytest_cache/

# Node.js dependencies & caches (dist is kept since it's the prebuilt UI bundle!)
frontend/node_modules/
frontend/.vite/
frontend/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Large ML model artifact (re-trained in 50s on demand: python ml/train_model.py)
ml/model.joblib

# Generated Pipeline Outputs (Re-generated by run.bat / run_all.py)
output/
data/raw_gps/
data/raw_rfid/

# Large Datasets (> 100MB exceeds standard GitHub 100MB limit)
data/kaggle_dataset/bangalore_routes.csv

# OS metadata
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
